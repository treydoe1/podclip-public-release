#!/usr/bin/env bash

set -euo pipefail

UPIA="/Library/Application Support/Adobe/Adobe Desktop Common/RemoteComponents/UPI/UnifiedPluginInstallerAgent/UnifiedPluginInstallerAgent.app/Contents/MacOS/UnifiedPluginInstallerAgent"
ZXP="/Library/Application Support/Podclip/Installer/Podclip.zxp"
CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console)"

if [[ ! -x "$UPIA" ]]; then
  echo "Adobe Creative Cloud's plugin installer is required. Install or update Creative Cloud Desktop, then run this installer again." >&2
  exit 1
fi

if [[ ! -f "$ZXP" ]]; then
  echo "The signed Podclip extension package is missing from the installer payload." >&2
  exit 1
fi

if [[ "$CONSOLE_USER" == "root" || "$CONSOLE_USER" == "loginwindow" ]]; then
  echo "Podclip must be installed while a macOS user is logged in." >&2
  exit 1
fi

/usr/bin/sudo -H -u "$CONSOLE_USER" "$UPIA" --install "$ZXP"
