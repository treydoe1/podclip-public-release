#!/usr/bin/env bash

set -euo pipefail

TARGET="/Library/Application Support/Adobe/CEP/extensions/com.podclip.panel"

for required in "$TARGET/CSXS/manifest.xml" "$TARGET/META-INF/signatures.xml"; do
  if [[ ! -f "$required" ]]; then
    echo "Podclip was not installed correctly: missing $required" >&2
    exit 1
  fi
done

/bin/chmod -R a+rX "$TARGET"
/usr/bin/xattr -dr com.apple.quarantine "$TARGET" 2>/dev/null || true
